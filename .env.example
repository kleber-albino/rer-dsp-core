# Template for .env — created automatically by ./config.sh, ./setup.sh or ./start.sh
# when .env does not exist yet. Edit this file only to change the defaults for new installs.

# --- Gateway (single entry point) ---------------------------------------------
# All HTTP traffic enters through dsp-gateway. Frontend, backend and GeoServers do not
# publish a host port; only the databases remain directly accessible.
DSP_HTTP_HOST=localhost
DSP_GATEWAY_HOST_PORT=8026
# Public stack URL (gateway host + port). Used in WMS/WFS URLs generated by
# ./config.sh and in each GeoServer PROXY_BASE_URL.
DSP_PUBLIC_BASE_URL=http://localhost:8026

# Nginx cache: empty enables it; any value bypasses it.
DSP_GATEWAY_CACHE_BYPASS=1
DSP_GATEWAY_CACHE_TTL=10m

# --- Databases ----------------------------------------------------------------
DSP_DB_HOST_PORT=20654
DSP_DB_NAME=dsp-db
DSP_DB_USER=dsp
DSP_DB_PASSWORD=dsp

DSP_GEOSERVER_DB_HOST_PORT=20656
DSP_GEOSERVER_DB_NAME=dsp-geoserver-db
DSP_GEOSERVER_DB_USER=dsp_geo
DSP_GEOSERVER_DB_PASSWORD=dsp_geo

# Source DB for ./setup.sh (Compose DSP_SOURCE_* overrides YAML source)
# Local test:
# DSP_SOURCE_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/source_db
# DSP_SOURCE_DB_USER=source_user
# DSP_SOURCE_DB_PASSWORD=source_user
DSP_SOURCE_JDBC_URL=jdbc:postgresql://source-db-host:5433/car_nacional
DSP_SOURCE_DB_USER=postgres
DSP_SOURCE_DB_PASSWORD=postgres

# ETL mapping: config/Job-Data-Migration/application/application.yaml
# Mode and schedule: ./setup.sh (Real adopter) preset 1/2/3 — crons when recurring re-sync applies.
#   once            — one-time run during setup (Run now + One-time)
#   continuous      — supercronic on DSP_MIGRATION_CRON; optional DSP_MIGRATION_SCHEDULED_AT for deferred first load
#   scheduled-once  — one run at DSP_MIGRATION_SCHEDULED_AT (Schedule for later + One-time)
DSP_MIGRATION_EXECUTION_MODE=once
# DSP_MIGRATION_CRON="0 22 * * *"   # generated by ./setup.sh (not typed manually)
# DSP_MIGRATION_SCHEDULED_AT="2026-08-27 22:00:00"
DSP_MIGRATION_TZ=America/Sao_Paulo

# --- Object storage / download pre-generation (SeaweedFS S3) -----------------
# dsp-object-storage in the core stack (profile object-storage). Brazil demo clears
# the endpoint — downloads use WFS only. Real adopter: endpoint/bucket/credentials via ./config.sh.
# Populated by ./config.sh (DSP_OBJECT_STORAGE_*).
# DSP_GEO_FILE_GENERATION_CRON: ./setup.sh Job 2/2 (same schedule menu as migration).
DSP_OBJECT_STORAGE_ENDPOINT=http://dsp-object-storage:8333
DSP_OBJECT_STORAGE_REGION=us-east-1
DSP_OBJECT_STORAGE_BUCKET=dsp-geo-files
DSP_OBJECT_STORAGE_ACCESS_KEY=dsp
DSP_OBJECT_STORAGE_SECRET_KEY=dsp-secret
DSP_OBJECT_STORAGE_PATH_STYLE_ACCESS=true
# Host port for diagnostics (aws s3 --endpoint-url http://localhost:8333).
DSP_OBJECT_STORAGE_HOST_PORT=8333
# Set by ./setup.sh preset: true = recurring service; false = one-time or wait-for-first-load.
DSP_GEO_FILE_GENERATION_RECURRING=true
# continuous | once | wait-for-first-load (deferred static first load).
DSP_GEO_FILE_GENERATION_EXECUTION_MODE=continuous
DSP_GEO_FILE_GENERATION_RESTART_POLICY=unless-stopped
DSP_GEO_FILE_GENERATION_CRON="0 2 * * *"
# Empty inherits DSP_MIGRATION_TZ.
DSP_GEO_FILE_GENERATION_TZ=
DSP_FIRST_DATA_LOAD_MARKER=/dsp-batch-markers/first_data_load.ready

# --- Backend ------------------------------------------------------------------
DSP_BACKEND_CONTEXT_PATH=/dsp-backend
# Through the gateway the frontend calls the backend on the same origin; 5173 covers local dev outside Docker.
DSP_CORS_ALLOWED_ORIGINS=http://localhost:8026,http://localhost:5173
DSP_INSTALLATION_CONFIG_FILE=file:/config/installation-config.json
DSP_MAP_LAYERS_FILE=file:/config/mapLayersConfig.json
DSP_DOWNLOAD_THEMES_FILE=file:/config/downloadThemesConfig.json
# Custom About page (config/about/): see ./config.sh's optional "About" stage.
DSP_ABOUT_CONFIG_FILE=file:/config/about/about-config.json
DSP_ABOUT_CONTENT_DIR=file:/config/about/
# Backend (container) → GeoServer Download on the Docker network. Do not use localhost here with Docker Compose.
DSP_GEOSERVER_WFS_BASE_URL=http://dsp-geoserver-download:8080/geoserver/dsp/wfs

# --- GeoServer Exhibition (map WMS/WFS) ----------------------------------------
# Published at ${DSP_PUBLIC_BASE_URL}/geoserver-exhibition
DSP_GEOSERVER_ADMIN_USER=admin
DSP_GEOSERVER_ADMIN_PASSWORD=geoserver

# --- GeoServer Download (WFS for /downloads) -----------------------------------
# Published at ${DSP_PUBLIC_BASE_URL}/geoserver-download

DSP_BACKEND_PATH=../rer-dsp-backend
DSP_FRONTEND_PATH=../rer-dsp-frontend
DSP_JOB_MIGRATION_PATH=../rer-dsp-job-data-migration
DSP_JOB_GEO_FILE_GENERATION_PATH=../rer-dsp-job-geo-file-generation

# --- Frontend -----------------------------------------------------------------
VITE_BASE_URL=/dsp/
# Relative path: the browser calls the backend on the same host/port as the gateway.
VITE_DSP_API_URL=/dsp-backend
APP_VERSION=0.0.0

# GeoServer Layer SRS (Coordinate Reference System)
LAYER_SRS_TERRITORY_LEVEL_1=4326
LAYER_SRS_TERRITORY_LEVEL_2=4326
LAYER_SRS_TERRITORY_LEVEL_3=4326
LAYER_SRS_AREA_OF_INTEREST=4326