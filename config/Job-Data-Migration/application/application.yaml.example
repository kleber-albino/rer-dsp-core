# Generic application.yaml template — edit application.yaml with your adopter source and ETL mapping.
# Generated from adopter-config.yaml by ./config.sh.
# Strings are quoted. Numbers, booleans and null are not.

spring:
  application:
    name: "dsp-batch"
  main:
    web-application-type: "none"
  datasource:
    batch:
      url: "jdbc:postgresql://dsp-db:5432/dsp-db?currentSchema=data_migration"
      username: "dsp"
      password: "dsp"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 10
        minimum-idle: 2
        pool-name: "batch-pool"
        connection-test-query: "SELECT 1"
    source:
      # Adopter source database (values from .env / Compose).
      url: "${DSP_SOURCE_JDBC_URL}"
      username: "${DSP_SOURCE_DB_USER}"
      password: "${DSP_SOURCE_DB_PASSWORD}"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
        pool-name: "source-pool"
    target:
      url: "jdbc:postgresql://dsp-db:5432/dsp-db"
      username: "dsp"
      password: "dsp"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
        pool-name: "target-pool"
    geo-target:
      url: "jdbc:postgresql://dsp-geoserver-db:5432/dsp-geoserver-db"
      username: "dsp_geo"
      password: "dsp_geo"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
        pool-name: "geo-target-pool"
  batch:
    job:
      enabled: false
    jdbc:
      initialize-schema: "never"

server:
  port: 8086

batch:
  # Product default for TIMESTAMP/DATE watermark columns without offset.
  # Ignored when the source column is timestamptz. Override only when naive
  # timestamps are stored in another zone (e.g. America/Santiago).
  source-timezone: "America/Sao_Paulo"
  admin-unit:
    # Adopter territorial hierarchy: L1 → L2 → L3 (parent_id links to the parent level)
    level-1:
      # Source table or SQL subquery. Replace the placeholders.
      source-table: "<source_schema>.<source_table>"
      target-table: "dsp.territory_level_1"
      primary-key: "<source_pk>"
      geometry-column: "<source_geom>"
      creation-date-column: "<source_created_at>"
      updated-at-column: "<source_updated_at>"
      where-clause: "1=1"
      persist-columns:
        - "<source_pk>"
        - "<source_name>"
        - "<source_created_at>"
      column-mapping:
        "<source_pk>": "id"
        "<source_name>": "name"
        "<source_geom>": "geom"
        "<source_created_at>": "created_at"
        "<source_updated_at>": "updated_at"
      layer-name: "territory-level-1"
      srid: "${LAYER_SRS_TERRITORY_LEVEL_1:4326}"
    level-2:
      source-table: "<source_schema>.<source_table>"
      target-table: "dsp.territory_level_2"
      primary-key: "<source_pk>"
      # Column used to partition the job in parallel (usually the parent).
      partition-column: "<source_parent_pk>"
      geometry-column: "<source_geom>"
      creation-date-column: "<source_created_at>"
      updated-at-column: "<source_updated_at>"
      where-clause: "1=1"
      persist-columns:
        - "<source_pk>"
        - "<source_name>"
        - "<source_parent_pk>"
        - "<source_created_at>"
      column-mapping:
        "<source_pk>": "id"
        "<source_name>": "name"
        "<source_parent_pk>": "parent_id"
        "<source_geom>": "geom"
        "<source_created_at>": "created_at"
        "<source_updated_at>": "updated_at"
      layer-name: "territory-level-2"
      srid: "${LAYER_SRS_TERRITORY_LEVEL_2:4326}"
    level-3:
      source-table: "<source_schema>.<source_table>"
      target-table: "dsp.territory_level_3"
      primary-key: "<source_pk>"
      partition-column: "<source_parent_pk>"
      geometry-column: "<source_geom>"
      creation-date-column: "<source_created_at>"
      updated-at-column: "<source_updated_at>"
      where-clause: "1=1"
      persist-columns:
        - "<source_pk>"
        - "<source_name>"
        - "<source_parent_pk>"
        - "<source_created_at>"
      column-mapping:
        "<source_pk>": "id"
        "<source_name>": "name"
        "<source_parent_pk>": "parent_id"
        "<source_geom>": "geom"
        "<source_created_at>": "created_at"
        "<source_updated_at>": "updated_at"
      layer-name: "territory-level-3"
      srid: "${LAYER_SRS_TERRITORY_LEVEL_3:4326}"
  area-of-interest:
    # Job creates dsp.area_of_interest on dsp-db and geo-target (canonical
    # columns + optional extras). Canonical source columns map to fixed names:
    #   primary-key → id
    #   creation-date-column → registration_date
    #   updated-at-column → updated_at
    #   commune-id-column → territory_level_3_id
    #   geometry-column → geom
    # persist-columns: extras only (same name on both destinations).
    # AOI area and theme KPI values are calculated by the KPI migration job
    # (see kpis below), not read from source columns.
    # Details-panel fields stay in installation-config.json, not in this YAML.
    source-table: "<source_schema>.<source_table>"
    target-table: "dsp.area_of_interest"
    primary-key: "<source_pk>"
    creation-date-column: "<source_created_at>"
    updated-at-column: "<source_updated_at>"
    commune-id-column: "<source_territory_level_3_fk>"
    territory-level-3-column: "<source_territory_level_3_fk>"
    total-area-column: "<source_area>"
    geometry-column: "<source_geom>"
    where-clause: "1=1"
    additional-columns: []
    layer-name: "area-of-interest"
    srid: "${LAYER_SRS_AREA_OF_INTEREST:4326}"
  # layers:
  #   - source-table: "conservation.mixed_geometries"
  #     primary-key: "feature_id"
  #     area-of-interest-id-column: "conservation_unit_id"
  #     creation-date-column: "<source_created_at>"
  #     updated-at-column: "updated_at"
  #     label-column: "name"
  #     geometry-column: "boundary"
  #     layer-name: "mixed_geometries"
  #     srid: 4326
  #     where-clause: "1=1"
  layers: []

# Theme KPI mappings: generated from installation.kpis in adopter-config.yaml.
# Each theme links a generic layer (etl.layers[].layer_name) to a KPI slot.
kpis:
  theme-count: 0
  area-unit-of-measurement: "m²"
  themes: []
  # Example (filled by ./config.sh):
  # themes:
  #   - slot: 1
  #     layer-name: "consolidated_area"
  #     unit-of-measurement: "ha"
  #     label: "Consolidated area"

parallelization:
  jobs:
    adminUnitLevel1GeoserverJob:
      enabled: true
      thread-pool-size: 1
      chunk-size: 1
      page-size: 1000
      queue-capacity: 100
    adminUnitLevel2GeoserverJob:
      enabled: true
      thread-pool-size: 12
      chunk-size: 1
      page-size: 1000
      queue-capacity: 100
    adminUnitLevel3GeoserverJob:
      enabled: true
      thread-pool-size: 12
      chunk-size: 470
      page-size: 1000
      queue-capacity: 100
    areaOfInterestGeoserverJob:
      enabled: true
      thread-pool-size: 1
      chunk-size: 100
      page-size: 1000
      queue-capacity: 100

execution-jobs:
  admin-unit-level-1-geoserver-job: true
  admin-unit-level-2-geoserver-job: true
  admin-unit-level-3-geoserver-job: true
  area-of-interest-geoserver-job: true
  layer-jobs: true
  kpi-job: true

logging:
  level:
    br.car.dsp_batch: "INFO"
