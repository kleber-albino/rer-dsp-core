# Generic application.yaml template of the geo file pre-generation job.
# Generated from adopter-config.yaml by ./config.sh — edit adopter-config.yaml, not this file.
# Strings are quoted. Numbers, booleans and null are not.

spring:
  application:
    name: "dsp-geo-file-generation"
  main:
    web-application-type: "none"
  datasource:
    # Spring Batch metadata for this job only. data_migration belongs to the migration job.
    batch:
      url: "jdbc:postgresql://dsp-db:5432/dsp-db?currentSchema=geo_file_generation"
      username: "dsp"
      password: "dsp"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 5
        minimum-idle: 1
        pool-name: "batch-pool"
        connection-test-query: "SELECT 1"
    # Territorial flags: which territory needs its files regenerated.
    target:
      url: "jdbc:postgresql://dsp-db:5432/dsp-db"
      username: "dsp"
      password: "dsp"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 5
        minimum-idle: 1
        pool-name: "target-pool"
    # Features to export — the same base the WFS reads.
    geo-target:
      url: "jdbc:postgresql://dsp-geoserver-db:5432/dsp-geoserver-db"
      username: "dsp_geo"
      password: "dsp_geo"
      driver-class-name: "org.postgresql.Driver"
      hikari:
        maximum-pool-size: 10
        minimum-idle: 2
        pool-name: "geo-target-pool"
  batch:
    job:
      enabled: false
    jdbc:
      initialize-schema: "never"

dsp:
  download:
    # Same catalogue the backend reads: themes and the formats to pre-generate.
    themes-file: "file:/config/downloadThemesConfig.json"
  object-storage:
    # Filled in by ./config.sh (bundled SeaweedFS for adopter real installs).
    endpoint: "http://dsp-object-storage:8333"
    region: "us-east-1"
    bucket: "dsp-geo-files"
    access-key: "dsp"
    secret-key: "dsp-secret"
    path-style-access: true

geo-file-generation:
  # One territory per chunk: the flag has to drop only for the territory that finished.
  chunk-size: 1
  orphan-cleanup-enabled: true

execution-jobs:
  geo-file-generation-job: true

logging:
  level:
    br.car.dsp_geo_file: "INFO"
